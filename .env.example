API_PORT=8000
WEB_PORT=5173
POSTGRES_USER=quotedrive
POSTGRES_PASSWORD=quotedrive_dev_password
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=quotedrive
JWT_SECRET_KEY=demo-insecure-secret-change-if-this-ever-leaves-localhost

# AI drafting (optional). Default "fake" calls no model: "Generate draft" shows an
# error and you can write the text yourself. Pick a real provider to see AI drafts.
AI_PROVIDER=fake
# OpenRouter: set AI_PROVIDER=openrouter and a key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Ollama on your machine: set AI_PROVIDER=ollama and a model you have pulled (`ollama list`).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
AI_REQUEST_TIMEOUT_SECONDS=30
